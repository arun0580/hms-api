generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum VisitType {
  NEW
  FOLLOW_UP
  EMERGENCY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum ReferenceType {
  DOCTOR
  HOSPITAL
  CLINIC
  FRIEND
  EMPLOYEE
  ONLINE
  CAMP
  INSURANCE
  SELF
}

enum AvailabilityStatus {
  AVAILABLE
  ON_LEAVE
  BUSY
  INACTIVE
}

enum ConsultationType {
  OP
  IP
  TELECONSULTATION
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ScheduleBlockType {
  BREAK
  LEAVE
  HOLIDAY
  EMERGENCY
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  CHEQUE
  NET_BANKING
}

enum DiscountType {
  NONE
  INSURANCE
  STAFF
  CAMP
  SENIOR
  OTHER
}

enum PregnancyStatus {
  NOT_APPLICABLE
  NOT_PREGNANT
  PREGNANT
  LACTATING
}

enum RegistrationStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opRegistrations OpRegistration[]

  @@map("users")
}

model Department {
  id            String             @id @default(cuid())
  name          String             @unique
  code          String?            @unique
  description   String?
  isActive      Boolean            @default(true) @map("is_active")
  doctors       Doctor[]
  doctorLinks   DoctorDepartment[]
  registrations OpRegistration[]
  appointments  Appointment[]

  @@map("departments")
}

model Doctor {
  id                 String                  @id @default(cuid())
  name               String
  code               String?                 @unique
  departmentId       String                  @map("department_id")
  department         Department              @relation(fields: [departmentId], references: [id])
  specialization     String?
  qualification      String?
  mobileNumber       String?                 @map("mobile_number")
  email              String?
  consultationFee    Decimal?                @map("consultation_fee") @db.Decimal(10, 2)
  availabilityStatus AvailabilityStatus      @default(AVAILABLE) @map("availability_status")
  consultationTiming String?                 @map("consultation_timing")
  weeklySchedule     Json?                   @map("weekly_schedule")
  profilePhotoUrl       String?                 @map("profile_photo_url")
  slotDurationMinutes   Int                     @default(15) @map("slot_duration_minutes")
  bufferMinutes         Int                     @default(5) @map("buffer_minutes")
  maxPatientsPerDay     Int?                    @map("max_patients_per_day")
  isActive              Boolean                 @default(true) @map("is_active")
  registrations         OpRegistration[]
  referredPatients      OpRegistration[]        @relation("ReferredDoctor")
  departments           DoctorDepartment[]
  consultationSlots     DoctorConsultationSlot[]
  appointments          Appointment[]
  scheduleBlocks        DoctorScheduleBlock[]

  @@map("doctors")
}

model DoctorDepartment {
  doctorId     String     @map("doctor_id")
  doctor       Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isPrimary    Boolean    @default(false) @map("is_primary")

  @@id([doctorId, departmentId])
  @@map("doctor_departments")
}

model DoctorConsultationSlot {
  id           String   @id @default(cuid())
  doctorId     String   @map("doctor_id")
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int      @map("day_of_week")
  startTime    String   @map("start_time")
  endTime      String   @map("end_time")
  maxPatients  Int?     @map("max_patients")

  @@index([doctorId, dayOfWeek])
  @@map("doctor_consultation_slots")
}

model Appointment {
  id                 String             @id @default(cuid())
  appointmentNumber  String             @unique @map("appointment_number")
  doctorId           String             @map("doctor_id")
  doctor             Doctor             @relation(fields: [doctorId], references: [id])
  departmentId       String             @map("department_id")
  department         Department         @relation(fields: [departmentId], references: [id])
  patientName        String             @map("patient_name")
  patientPhone       String?            @map("patient_phone")
  opRegistrationId   String?            @map("op_registration_id")
  consultationType   ConsultationType   @map("consultation_type")
  appointmentDate    DateTime           @map("appointment_date")
  startTime          String             @map("start_time")
  endTime            String             @map("end_time")
  status             AppointmentStatus  @default(SCHEDULED)
  notes              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([doctorId, appointmentDate])
  @@index([departmentId, appointmentDate])
  @@map("appointments")
}

model DoctorScheduleBlock {
  id         String            @id @default(cuid())
  doctorId   String            @map("doctor_id")
  doctor     Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  blockDate  DateTime          @map("block_date")
  startTime  String?           @map("start_time")
  endTime    String?           @map("end_time")
  blockType  ScheduleBlockType @map("block_type")
  title      String?
  isFullDay  Boolean           @default(false) @map("is_full_day")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([doctorId, blockDate])
  @@map("doctor_schedule_blocks")
}

model HospitalBranch {
  id            String           @id @default(cuid())
  name          String           @unique
  code          String?          @unique
  isActive      Boolean          @default(true) @map("is_active")
  registrations OpRegistration[]

  @@map("hospital_branches")
}

model RegistrationCounter {
  id            String           @id @default(cuid())
  name          String           @unique
  code          String?          @unique
  location      String?
  isActive      Boolean          @default(true) @map("is_active")
  registrations OpRegistration[]
  staffAssignments CounterStaff[]

  @@map("registration_counters")
}

model StaffMember {
  id            String           @id @default(cuid())
  name          String
  employeeCode  String?          @unique @map("employee_code")
  isActive      Boolean          @default(true) @map("is_active")
  registrations OpRegistration[]
  counterAssignments CounterStaff[]

  @@map("staff_members")
}

model CounterStaff {
  counterId String              @map("counter_id")
  counter   RegistrationCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  staffId   String              @map("staff_id")
  staff     StaffMember         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([counterId, staffId])
  @@map("counter_staff")
}

model InsuranceProvider {
  id                   String           @id @default(cuid())
  name                 String           @unique
  code                 String?          @unique
  isActive             Boolean          @default(true) @map("is_active")
  referenceRegistrations OpRegistration[] @relation("InsuranceReference")
  billingRegistrations   OpRegistration[] @relation("BillingInsurance")

  @@map("insurance_providers")
}

model Corporate {
  id            String           @id @default(cuid())
  name          String           @unique
  code          String?          @unique
  isActive      Boolean          @default(true) @map("is_active")
  registrations OpRegistration[]

  @@map("corporates")
}

model OpRegistration {
  id String @id @default(cuid())

  opNumber         String   @unique @map("op_number")
  registrationDate DateTime @map("registration_date")
  visitType        VisitType @map("visit_type")
  departmentId     String   @map("department_id")
  department       Department @relation(fields: [departmentId], references: [id])
  doctorId         String   @map("doctor_id")
  doctor           Doctor   @relation(fields: [doctorId], references: [id])
  tokenNumber      Int      @map("token_number")
  appointmentId    String?  @map("appointment_id")

  firstName         String   @map("first_name")
  middleName        String?  @map("middle_name")
  lastName          String   @map("last_name")
  gender            Gender
  dateOfBirth       DateTime @map("date_of_birth")
  age               Int?
  bloodGroup        BloodGroup?   @map("blood_group")
  maritalStatus     MaritalStatus? @map("marital_status")
  nationality       String?
  aadhaarNumber     String?  @map("aadhaar_number")
  patientPhotoUrl   String?  @map("patient_photo_url")
  occupation        String?
  religion          String?
  preferredLanguage String?  @map("preferred_language")

  mobileNumber    String  @map("mobile_number")
  alternateMobile String? @map("alternate_mobile")
  email           String?
  addressLine1    String? @map("address_line_1")
  addressLine2    String? @map("address_line_2")
  city            String?
  state           String?
  district        String?
  country         String? @default("India")
  pinCode         String? @map("pin_code")

  referenceType          ReferenceType? @map("reference_type")
  referredDoctorId       String?        @map("referred_doctor_id")
  referredDoctor         Doctor?        @relation("ReferredDoctor", fields: [referredDoctorId], references: [id])
  referredByName         String?       @map("referred_by_name")
  referrerOrganization   String?       @map("referrer_organization")
  referrerContact        String?       @map("referrer_contact")
  referrerId             String?       @map("referrer_id")
  referralDate           DateTime?     @map("referral_date")
  referralNotes          String?       @map("referral_notes")
  marketingSource        String?       @map("marketing_source")
  campEventName          String?       @map("camp_event_name")
  employeeReferenceId    String?       @map("employee_reference_id")
  employeeReference      StaffMember?  @relation(fields: [employeeReferenceId], references: [id])
  insuranceReferenceId   String?       @map("insurance_reference_id")
  insuranceReference     InsuranceProvider? @relation("InsuranceReference", fields: [insuranceReferenceId], references: [id])
  corporateReferenceId   String?       @map("corporate_reference_id")
  corporateReference     Corporate?    @relation(fields: [corporateReferenceId], references: [id])

  emergencyContactName     String? @map("emergency_contact_name")
  emergencyRelationship    String? @map("emergency_relationship")
  emergencyMobile          String? @map("emergency_mobile")
  emergencyAddress         String? @map("emergency_address")

  chiefComplaint      String?  @map("chief_complaint")
  allergies           String?
  existingDiseases    String[] @default([]) @map("existing_diseases")
  currentMedications  String?  @map("current_medications")
  pastSurgeries       String?  @map("past_surgeries")
  pregnancyStatus     PregnancyStatus? @map("pregnancy_status")
  heightCm            Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg            Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bmi                 Decimal? @db.Decimal(5, 2)
  bloodPressure       String?  @map("blood_pressure")
  pulse               String?
  temperature         String?

  insuranceAvailable    Boolean  @default(false) @map("insurance_available")
  insuranceProviderId   String?  @map("insurance_provider_id")
  insuranceProvider     InsuranceProvider? @relation("BillingInsurance", fields: [insuranceProviderId], references: [id])
  policyNumber          String?  @map("policy_number")
  tpaName               String?  @map("tpa_name")
  insuranceValidTill    DateTime? @map("insurance_valid_till")
  insuranceCardUrl      String?  @map("insurance_card_url")

  registrationFee   Decimal @default(0) @map("registration_fee") @db.Decimal(10, 2)
  consultationFee   Decimal @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  paymentMethod     PaymentMethod? @map("payment_method")
  discountType      DiscountType @default(NONE) @map("discount_type")
  discountAmount    Decimal @default(0) @map("discount_amount") @db.Decimal(10, 2)
  netAmount         Decimal @default(0) @map("net_amount") @db.Decimal(10, 2)
  receiptNumber     String  @unique @map("receipt_number")

  consentAccepted          Boolean @default(false) @map("consent_accepted")
  smsConsent               Boolean @default(false) @map("sms_consent")
  emailConsent             Boolean @default(false) @map("email_consent")
  privacyPolicyAccepted    Boolean @default(false) @map("privacy_policy_accepted")
  signatureDataUrl         String? @map("signature_data_url")

  createdById             String? @map("created_by_id")
  createdBy               User?   @relation(fields: [createdById], references: [id])
  registrationCounterId   String? @map("registration_counter_id")
  registrationCounter     RegistrationCounter? @relation(fields: [registrationCounterId], references: [id])
  hospitalBranchId        String? @map("hospital_branch_id")
  hospitalBranch          HospitalBranch? @relation(fields: [hospitalBranchId], references: [id])
  status                  RegistrationStatus @default(ACTIVE)
  remarks                 String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([registrationDate])
  @@index([departmentId, registrationDate])
  @@map("op_registrations")
}
